# ============================================================================
# Adaptive RAG — Environment Template
# Copy to .env and fill real values. NEVER commit the real .env.
# Identity model: the runtime role (app_rag) is least-privilege + RLS-enforced;
# schema sync / cache eviction / TTL purge use the unpooled admin identity.
# ============================================================================

# --- Persistence layer (db.py, DB_ prefix) ----------------------------------
# Runtime identity: LEAST-PRIVILEGE role (app_rag) — RLS-bound, no schema rights.
DB_DATABASE_URL=postgresql://app_rag:change-me@ep-xxx.neon.tech/neondb?sslmode=require
# Admin identity: unpooled OWNER connection (schema sync, eviction, TTL purge).
DB_ADMIN_DATABASE_URL=postgresql://owner:change-me@ep-xxx.neon.tech/neondb?sslmode=require
# Aliases accepted: NEON_DATABASE_URL -> DB_DATABASE_URL,
#                   NEON_ADMIN_DATABASE_URL -> DB_ADMIN_DATABASE_URL

# --- Orchestration (adaptive_rag.py, RAG_ prefix) ---------------------------
RAG_PROVIDER=groq                  # groq | google | openrouter | openai_compatible

# Generic OpenAI-compatible seam (RAG_PROVIDER=openai_compatible):
# any Cerebras / SambaNova / NVIDIA NIM / vLLM endpoint — zero glue code.
# RAG_BASE_URL=https://api.cerebras.ai/v1
# RAG_API_KEY=                     # or set in env; models are MANDATORY:
# RAG_ROUTER_MODEL=llama-3.3-70b
# RAG_FLEET_MODEL=llama-3.3-70b
# RAG_EXECUTIVE_MODEL=llama-3.3-70b

# Stage-aware failover (router+fleet ONLY; executive is PINNED — a quota wall
# there ends in verified refusal, never a weaker model certifying a brief).
# JSON list; tried in order on 429/quota errors; per-endpoint cooldown honors
# the provider's own retry hint ("try again in 10m44s").
# RAG_FAILOVER_ENDPOINTS=[{"base_url":"https://api.cerebras.ai/v1","api_key_env":"CEREBRAS_API_KEY","model":"llama-3.3-70b"},{"base_url":"https://integrate.api.nvidia.com/v1","api_key_env":"NIM_API_KEY","model":"meta/llama-3.3-70b-instruct"}]

# --- Researched free/cheap fallbacks (2026-09; verified reachable, no geo-block) --
# GitHub Models: RETIRED (2026-07). Cerebras: permanent free tier DISCONTINUED
# ($5 one-time credit, expires). Groq free: 30 RPM / 1K RPD / 200K TPD PER MODEL
# (gpt-oss-20b, qwen3.8-27b, gpt-oss-120b have SEPARATE budgets).
# Google free budgets are PER-MODEL: gemini-3.6-flash caps at ~20 req/day;
# gemini-3.5-flash sits on the 1,500-RPD tier (hence the provider default).
#
# 1) MODELSCOPE (Alibaba) — best genuinely-free option: 2,000 RPD total,
#    <=500 RPD per model, ~59 free models incl. Qwen3.5-27B (131K ctx).
#    Signup (email, no card): https://modelscope.cn/my/myaccesstoken
#    Then enumerate: python scripts/list_models.py openai_compatible \
#        https://api-inference.modelscope.cn/v1 MODELSCOPE_TOKEN
#    and build ONE complete JSON list (the setting is a single value — no
#    append syntax). ModelScope first, keeping any entries you already use:
#MODELSCOPE_TOKEN=
# RAG_FAILOVER_ENDPOINTS=[{"base_url":"https://api-inference.modelscope.cn/v1","api_key_env":"MODELSCOPE_TOKEN","model":"Qwen/Qwen3.5-27B"}]
#
# 2) DEEPSEEK — no free tier, but ~$0.15-0.30/day at our volumes
#    (v4-flash $0.44/M in, $1.32/M out; 50% off-peak — off-peak = everything
#    except weekday 06:00-10:00 & 01:00-04:00 UTC; 2,500 concurrency).
#    Strongest quality-per-cent of the options; the only fallback whose
#    model grade justifies executive-stage pinning on quota-storm days.
#    Signup: https://platform.deepseek.com/api_keys
#DEEPSEEK_API_KEY=
# Optional: pin executive to DeepSeek by uncommenting (bypasses failover-pin):
# RAG_PROVIDER=openai_compatible
# RAG_BASE_URL=https://api.deepseek.com/v1
# RAG_API_KEY will be read from DEEPSEEK_API_KEY if set in env, else set it here
# RAG_ROUTER_MODEL=deepseek-v4-flash
# RAG_FLEET_MODEL=deepseek-v4-flash
# RAG_EXECUTIVE_MODEL=deepseek-v4-flash
#
# OPERATIONAL RULE (unchanged): any model assigned to a stage MUST first pass
# the 16-point benchmark: RAG_DISABLE_CACHE_WRITE=1 python adaptive_rag.py

RAG_ROUTER_MODEL=                  # blank -> provider-aware default
RAG_FLEET_MODEL=
RAG_EXECUTIVE_MODEL=
RAG_FLEET_MAX_TOKENS=800
RAG_SYNTH_MAX_TOKENS=1800
RAG_LLM_TIMEOUT_S=45
RAG_DB_TIMEOUT_S=20
RAG_MAX_RETRIES=2
RAG_MAX_CONCURRENT_RUNS=8
RAG_CACHE_SIMILARITY=0.92
RAG_CB_FAILURE_THRESHOLD=5
RAG_CB_COOLDOWN_S=60
# RAG_DISABLE_CACHE_WRITE=1        # eval/benchmark kill-switch (never pollute prod cache)

# --- Provider API keys -------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=                    # used when RAG_PROVIDER=google
OPENROUTER_API_KEY=                # used when RAG_PROVIDER=openrouter


# --- Token Router (verified 2026-09-09) -------------------------------------
# OpenAI-compatible aggregator (131 models, chat-completions, base_url below).
# FREE LANE: z-ai/glm-5.3-free (Input $0.00 / Output $0.00 — tagged Test).
# No documented daily token cap; concurrency is balance-tiered (free: 5).
# Measured: serves 4K-token synthesis-size prompts (90s — queueing is real,
# hence timeout_s=150 in the failover entry). Wire ONLY as failover lane;
# promotion to any primary stage requires the 16-point benchmark (ADR-008).
TOKENROUTER_API_KEY=                # console: https://www.tokenrouter.com/console/token
# Failover entry shape:
#   {"base_url":"https://api.tokenrouter.com/v1","api_key_env":"TOKENROUTER_API_KEY",
#    "model":"z-ai/glm-5.3-free","timeout_s":150}
# Other free/reasonable models on the lane: nvidia/nemotron-3-nano-*:free,
#   z-ai/glm-5.3-flash ($0.075/$0.25 per 1M — the cheap paid fallback).

# --- Serving layer (main.py) -------------------------------------------------
PORT=8000
SERVICE_RATE_LIMIT_PER_MIN=10      # per-IP token-bucket refill rate
ADMIN_API_KEY=                     # enables POST /feedback eviction (fail-closed if unset)
QUERY_API_KEYS=                    # tenant auth for /query + /query/stream, 'tenant:key' comma-separated
                                   #   e.g. acme:sk-acme-1f2...,globex:sk-globex-9a3...
                                   # UNSET = OPEN MODE (local/demo: callers are the default tenant —
                                   #   matches the Streamlit demo posture). SET = X-API-Key header
                                   #   required on every query; the key's tenant IS the identity and
                                   #   overrides any declared tenant_id (cross-tenant 403, no key 401).
LOG_FORMAT=text                    # text | json (structured logs with request_id)

# --- UX client (app.py) ------------------------------------------------------
API_BASE_URL=http://localhost:8000
