  "cards": [
    {
      "dot": "cyan",
      "title": "Every figure is reachable from its bytes",
      "items": [
        "chunk_hash = sha256(company \u22a3 source \u22a3 page \u22a3 slice) \u2014 the receipt recomputes it",
        "fact_rows carry char_start/char_end into the page transcript",
        "source_registry pins each PDF's sha256, so a swapped file breaks the chain"
      ]
    },
    {
      "dot": "violet",
      "title": "Two independent producers of truth",
      "items": [
        "Prose path: PDF \u2192 transcripts \u2192 chunks + vectors \u2192 hybrid search",
        "Structured path: SEC XBRL \u2192 fact_rows \u2192 exact match",
        "Where the two agree, the answer needs no model at all"
      ]
    },
    {
      "dot": "amber",
      "title": "Epoch-scoped by design",
      "items": [
        "Corpus epoch is stamped on chunks, facts and cache entries",
        "A re-ingest bumps the epoch; stale cache entries stop matching",
        "The receipt records which epoch produced the answer"
      ]
    }
  ]
