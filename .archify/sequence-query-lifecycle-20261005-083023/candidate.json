  "cards": [
    {
      "dot": "cyan",
      "title": "Two deterministic exits before any model call",
      "items": [
        "A near-exact cache hit replays the certified answer with its provenance",
        "A covered company+metric+period is served from the fact store",
        "Both return without spending a single LLM token"
      ]
    },
    {
      "dot": "amber",
      "title": "Every path ends in a receipt",
      "items": [
        "Certified runs write a receipt whose spans re-hash to their chunk_hash",
        "Refusals write verdict='refused' \u2014 the autopsy trail",
        "A replay points at the run that EARNED the certification"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-closed is a path, not an error",
      "items": [
        "Router outage, quarantined specialist, zero documents \u2192 refuse",
        "Each refusal names its true cause instead of blaming the question",
        "max_retries=2, then the run refuses rather than guessing"
      ]
    }
